<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0"
      style="-fx-background-color: white;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.project_final_gp1.controller.HabitacionFornController">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <children>

        <Label fx:id="lblTitulo"
               text="Datos de la habitación"
               textFill="#014074">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>

        <Separator prefWidth="200.0"/>

        <GridPane hgap="10.0" vgap="15.0">

            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES"
                                   minWidth="10.0"
                                   prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES"
                                   minWidth="10.0"
                                   prefWidth="150.0"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>

            <children>

                <Label text="Número"/>

                <TextField fx:id="txtNumero"
                           promptText="Ingrese el número"
                           GridPane.columnIndex="1"/>

                <Label text="Piso"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtNumeroPiso"
                           promptText="Ingrese el piso"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Número de habitación"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtNumeroHabitacion"
                           promptText="Ingrese el número de habitación"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Tipo"
                       GridPane.rowIndex="3"/>

                <ComboBox fx:id="cbTipo"
                          maxWidth="Infinity"
                          promptText="Seleccione el tipo"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Precio"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="txtPrecio"
                           promptText="Ingrese el precio"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                <Label text="Estado"
                       GridPane.rowIndex="5"/>

                <ComboBox fx:id="cbEstado"
                          maxWidth="Infinity"
                          promptText="Seleccione el estado"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"/>

            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>

                <Button mnemonicParsing="false"
                        onAction="#handleCancel"
                        prefHeight="31.0"
                        prefWidth="100.0"
                        styleClass="button-action-delete"
                        text="Cancelar"/>

                <Button mnemonicParsing="false"
                        onAction="#handleSaved"
                        prefHeight="31.0"
                        prefWidth="100.0"
                        styleClass="button-action-edit"
                        text="Guardar"/>

            </children>
        </HBox>

    </children>
</VBox>
