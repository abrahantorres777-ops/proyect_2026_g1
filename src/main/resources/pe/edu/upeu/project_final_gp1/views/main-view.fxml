<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.project_final_gp1.controller.MainController">
    <!--CABECERA DEL PROJECT  -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header" BorderPane.alignment="CENTER">
            <children>
                <Label text="HOTEL" textFill="#014074">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <HBox.margin><Insets left="10.0" /></HBox.margin>
                </Label>
                <Label text="Residencias UPeU" textFill="#666666">
                    <HBox.margin><Insets left="10.0" /></HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Bienvenido, Usuario" textFill="#014074">
                    <font><Font name="System Italic" size="13.0" /></font>
                    <HBox.margin><Insets right="20.0"/></HBox.margin>
                </Label>
            </children>
        </HBox>
    </top>
    <!--MENU LATERAL -->
    <left>
        <VBox prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER" >
            <children>
                <Button maxWidth="-Infinity" mnemonicParsing="false"
                        onAction="#showHome" styleClass="nav-button" text="Inicio"/>
                <Button maxWidth="-Infinity" mnemonicParsing="false"
                        onAction="#showCliente" styleClass="nav-button" text="Clientes"/>
                <Button maxWidth="-Infinity" mnemonicParsing="false"
                        onAction="#showHabitacion" styleClass="nav-button" text="Habitaciones"/>
            </children>
        </VBox>
    </left>
    <center>
        <VBox BorderPane.alignment="center">
        <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Seleccione una opcion del Menu" textFill="#999999" />
            </children>
        </StackPane>
            <VBox alignment="CENTER" prefWidth="20.0">
                <children>
                    <Label text="copyright HARRY-2026"
                           textFill="#999999"/>
                </children>
            </VBox>
        </VBox>
    </center>


</BorderPane>